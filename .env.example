# Copy to .env.local (local) or add in your host's Environment Variables (e.g. Vercel → Settings → Environment Variables)

# --- App login ---
APP_PASSWORD=choose-a-strong-password
# Signs the login cookie. Any long random string (e.g. `openssl rand -hex 32`). Falls back to APP_PASSWORD if unset.
SESSION_SECRET=

# --- Google Sheets (unchanged) ---
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
# Optional: tab name. Empty = first tab (same as before)
GOOGLE_SHEET_TAB=

# --- GameBoost ---
# Partner Dashboard → Settings → Developers → New API Key. Server-side only, never exposed to the browser.
GAMEBOOST_API_KEY=
# Optional override (default https://api.gameboost.com/v2)
GAMEBOOST_API_BASE=
# Text sent as the "credentials" entry when an employee leaves credentials empty (GameBoost requires at least one).
GAMEBOOST_MANUAL_CREDENTIAL_PLACEHOLDER=Manual delivery - the seller delivers this account to the buyer through the order chat.

# Optional: lets a scheduler call GET /api/gameboost/sync with `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=

# Optional: extra text that means "this offer is gone" on source pages, separated by |
# (built in: "offer not found", plus the Russian FunPay wording)
SOURCE_NOT_FOUND_PHRASES=

# --- AI (free hosted models; fallback chain, first usable entry wins) ---
# Format: provider:model[,provider:model...]. Providers: groq, gemini, openrouter, ollama (local).
# Get a free Groq key at console.groq.com (no card). Model names change - check the provider's list if one stops working.
AI_PROVIDERS=groq:llama-3.3-70b-versatile,groq:llama-3.1-8b-instant,gemini:gemini-2.5-flash
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional: stop using a chain entry after this many tokens per day (0 = off)
AI_DAILY_TOKEN_BUDGET=0
# Optional: extra banned words/phrases for titles and descriptions, separated by | or commas (EN or RU)
BLOCKLIST_EXTRA=

# Price currency read from FunPay (buyer price). Default USD.
# SOURCE_PRICE_CURRENCY=USD
# Tab used for shared app state (created by the app; never an existing tab). Default LS_STATE.
# STATE_SHEET_TAB=LS_STATE
# Batch page: 1 = list offers immediately; unset = create as drafts (testing phase)
# AUTO_LIST_NOW=
